# Final DARA-AD configuration used in the paper

export DECO_RATFD_ABLATION=no_second_stage
export DECO_RSDA_MODE=full
export DECO_SCORE_MODE=clean_white
export DECO_NOISE_BETA=0.03
export DECO_RGA_ENABLED=1

export DECO_SEED=2026
export DECO_EPOCHS=8
export DECO_LR=0.001
export DECO_GAMMA_INIT=0.75
export DECO_DROPOUT=0.05
export DECO_D_MODEL=64
export DECO_N_HEADS=4
export DECO_NUM_LAYERS=2
export DECO_MAX_TRAIN_WINDOWS=4096
export DECO_BATCH_SIZE=128

export DECO_RGA_GATE_STRENGTH=0.50
export DECO_RGA_MAX_SCALE=0.05
